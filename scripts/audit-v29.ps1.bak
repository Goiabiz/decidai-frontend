# Auditoria v29
Write-Host "Auditando v29..." -ForegroundColor Cyan

$failed = $false
$patterns = @("Ãƒ", "Ã", "Â", "�")
$files = Get-ChildItem -Path "src" -Recurse -Include *.tsx,*.ts,*.css -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notmatch "textEncoding\.ts" }

foreach ($file in $files) {
  $bytes = [System.IO.File]::ReadAllBytes($file.FullName)
  if ($bytes.Length -ge 3 -and $bytes[0] -eq 239 -and $bytes[1] -eq 187 -and $bytes[2] -eq 191) {
    Write-Host "BOM encontrado: $($file.FullName)" -ForegroundColor Red
    $failed = $true
  }

  $content = Get-Content $file.FullName -Raw
  foreach ($pattern in $patterns) {
    if ($content.Contains($pattern)) {
      Write-Host "Possível mojibake: $($file.FullName)" -ForegroundColor Yellow
      $failed = $true
      break
    }
  }

  if ($content.Contains("window.confirm(")) {
    Write-Host "window.confirm encontrado: $($file.FullName)" -ForegroundColor Yellow
    $failed = $true
  }

  if ($content.Contains("replaceAll(")) {
    Write-Host "replaceAll encontrado: $($file.FullName)" -ForegroundColor Yellow
    $failed = $true
  }
}

if (-not $failed) {
  Write-Host "Auditoria v29 limpa." -ForegroundColor Green
} else {
  Write-Host "Auditoria encontrou pontos para revisão." -ForegroundColor Yellow
}
